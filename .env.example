# Copy to .env and edit. `docker compose` reads this file, and so does Altiplano when
# it sits at ~/.config/altiplano/env on a host install.

# The Vikunja API root. The /api/v1 or /api/v2 suffix selects the version.
VIKUNJA_URL=https://todo.example.com/api/v1

# Read on the stdio transport alone. Every HTTP caller acts as its own Vikunja user,
# from a token held against its record in the client store, and nothing on the HTTP
# path reads this.
VIKUNJA_API_TOKEN=tk_replace_me

# Everything below is read by `altiplano-http` alone. The stdio command ignores it.
#
# 127.0.0.1 keeps the listener on this machine. Binding anywhere else requires at
# least one client token, and the server refuses to start without one. The container
# sets this to 0.0.0.0 itself: a published port reaches nothing otherwise.
#ALTIPLANO_HTTP_HOST=127.0.0.1

# Under Docker this drives both sides of the port mapping. Altiplano binds it in the
# container and Docker publishes the same number, and several containers on one host
# differ only by this line. Stay above 1024: the container is unprivileged.
#ALTIPLANO_HTTP_PORT=8000
#ALTIPLANO_HTTP_PATH=/mcp
#
# Accepted HTTP Host values, comma separated. These prevent DNS rebinding, and the
# client tokens are the access control.
#
# Setting this replaces the loopback defaults outright. Name every address clients
# will use. List both forms of each: `host:*` matches a Host header with a port, a
# bare `host` matches one without, and neither covers the other. A missing value
# produces a 421.
#ALTIPLANO_HTTP_ALLOWED_HOSTS=altiplano.home.arpa,altiplano.home.arpa:*
#
# Accepted browser Origin values. Native clients send no Origin header.
#ALTIPLANO_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
#
# Where the client token store lives. Defaults to a `clients` file beside this one.
# The container sets its own path, on the volume.
#ALTIPLANO_CLIENTS=/etc/altiplano/clients

# The base image the container builds on. Pin it for a reproducible build.
#ALPINE_VERSION=3.22
